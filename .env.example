# Copy to .env and fill in values. Never commit .env.
# Offline reproduce (pytest + --draft template) needs no key.
# --draft llm works without a key when data/processed/llm_cache/ hits;
# a live key is only required for --no-cache or cache misses.

GROQ_API_KEY=your_key_here

# Optional backups — used automatically when earlier keys hit 429/TPD
# (must be a different Groq org to add daily quota)
# GROQ_API_KEY_2=
# GROQ_API_KEY_3=

# Optional overrides (defaults live in src/config.py)
# LLM_MODEL=openai/gpt-oss-20b
